# =============================================================
# SOLANA MEV BOT - EXAMPLE CONFIGURATION
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# WARNING: Never commit .env to git. It contains your private key.
# =============================================================

# --- RPC Connection (REQUIRED) ---
# Get a paid RPC from: helius.dev, quicknode.com, triton.one, alchemy.com
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# --- Wallet (REQUIRED) ---
# Base58-encoded private key. Generate with: solana-keygen new
SOLANA_KEYPAIR=YOUR_BASE58_PRIVATE_KEY_HERE

# --- Safety (IMPORTANT) ---
# false = demo mode (simulates but never sends real transactions)
# true  = live mode (sends real transactions with real SOL)
ENABLE_REAL_EXECUTION=false

# --- Trading Parameters ---
MIN_PROFIT_SOL=0.001
MAX_SLIPPAGE_PCT=1.0
BOT_COMPUTE_UNIT_LIMIT=600000
PRIORITY_FEE_LAMPORTS=10000
LOOP_INTERVAL_MS=500
REFRESH_INTERVAL_MS=2000

# --- Dynamic CU & Priority Fees (Recommended) ---
# Estimate compute units from simulation instead of using static BOT_COMPUTE_UNIT_LIMIT
DYNAMIC_CU_ENABLED=false
CU_BUFFER_PCT=0.15
# Fetch priority fee from getRecentPrioritizationFees instead of using static PRIORITY_FEE_LAMPORTS
DYNAMIC_FEE_ENABLED=false
FEE_PERCENTILE=75

# --- Jito MEV Bundles (Recommended for production) ---
JITO_ENABLED=false
JITO_TIP_LAMPORTS=10000
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# --- Kamino Flash Loans (Optional) ---
FLASHLOAN_ENABLED=false
FLASHLOAN_RESERVE=
FLASHLOAN_RESERVE_VAULT=
FLASHLOAN_FEE_RECEIVER=

# --- Address Lookup Tables (Optional) ---
# Comma-separated pubkeys of ALTs to use for v0 transaction compression
# Create with solana-keygen or use existing DEX ALTs
ALT_ADDRESSES=

# --- Multi-RPC Submission (Optional) ---
SPAM_ENABLED=false
SPAM_SENDING_RPC_URLS=

# --- Token Mints and Pool Addresses ---
# Configure up to 10 tokens (MINT_1 through MINT_10).
# For each token, list pool addresses per DEX (comma-separated).
# You need pools on at least 2 different DEXes for arbitrage.

# Example: SOL/USDC arbitrage (working pool addresses as of Feb 2026)
MINT_1=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MINT_1_RAYDIUM_POOL_LIST=
MINT_1_RAYDIUM_CP_POOL_LIST=
MINT_1_RAYDIUM_CLMM_POOL_LIST=3ucNos4NbumPLZNWztqGHNFFgkHeRMBQAVemeeomsUxv
MINT_1_WHIRLPOOL_POOL_LIST=FpCMFDFGYotvufJ7HrFHsWEiiQCGbkLCtwHiDnh7o28Q
MINT_1_DLMM_POOL_LIST=
MINT_1_METEORA_DAMM_POOL_LIST=
MINT_1_METEORA_DAMM_V2_POOL_LIST=
MINT_1_PUMP_POOL_LIST=
MINT_1_SOLFI_POOL_LIST=
MINT_1_VERTIGO_POOL_LIST=
MINT_1_PHOENIX_POOL_LIST=
MINT_1_LIFINITY_POOL_LIST=
MINT_1_HEAVEN_POOL_LIST=

# MINT_2=<token_mint_address>
# MINT_2_RAYDIUM_POOL_LIST=<pool_address>
# ... etc (same pattern for all DEXes)
